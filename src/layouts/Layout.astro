const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const ogLocale = lang === 'en' ? 'en_US' : 'fr_FR';
const alternateLang = lang === 'fr' ? 'en' : 'fr';
const alternateURL = lang === 'fr' ? `${siteUrl}en/` : siteUrl;

