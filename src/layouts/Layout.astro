		<meta name="twitter:description" content={description} />
		<meta name="twitter:url" content={canonicalURL.href} />
		<meta name="twitter:image" content="https://7bhil.vercel.app/pro.webp" />

		<!-- Social Identity Links (IndieWeb / WebID) -->
