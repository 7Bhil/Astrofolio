		<link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png?v=6" />
		<link rel="icon" type="image/png" sizes="128x128" href="/favicon-128.png?v=6" />
		<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=6" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Canonical & Language Alternates -->
		<link rel="canonical" href={canonicalURL.href} />
		<link rel="alternate" hreflang="fr" href="https://7bhil.vercel.app/" />
		<link rel="alternate" hreflang="en" href="https://7bhil.vercel.app/en/" />
		<link rel="alternate" hreflang="x-default" href="https://7bhil.vercel.app/" />

		<!-- Verification Google & Bing Webmaster -->
		<meta name="google-site-verification" content="KrRDN87OdCwPlcy2HMmE4XdV_MGYa2VTp03WX50eeJE" />
		<meta name="msvalidate.01" content="7A6143E2FE2886DAF47161C45A645F15" />

		<!-- Title & Standard Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Bhilal CHITOU" />
		<meta name="keywords" content="Bhilal CHITOU, 7Bhil, Spécialiste Fintech, Cybersécurité, Langage Bhilal, Solutions Fintech, Remote worldwide, développeur remote Afrique, Parakou, Bénin, React, React Native, Node.js, Django, Laravel, sécurité informatique, Mobile Money" />
		
		<!-- Robot Directives for Search Engines & AI Bots -->
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
		<meta name="bingbot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
