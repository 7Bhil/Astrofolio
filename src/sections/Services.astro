---
import { CreditCard, Zap, ShieldCheck } from 'lucide-react';
import { getTranslations } from '../utils/t';

const { lang = 'fr' } = Astro.props;

const services = [
  {
    icon: CreditCard,
    titleFr: "Fintech & Paiement",
    titleEn: "Fintech & Payment",
    descFr: "Digitalisation des transactions, paiements mobiles et portefeuilles électroniques sécurisés.",
    descEn: "Transaction digitalization, mobile payments and secure electronic wallets.",
    gradient: "linear-gradient(135deg, #2962FF 0%, #1E40AF 100%)",
  },
  {
    icon: Zap,
    titleFr: "Automatisation",
    titleEn: "Automation",
    descFr: "Transformation des processus manuels en systèmes automatisés, robustes et évolutifs.",
    descEn: "Transforming manual processes into automated, robust and scalable systems.",
    gradient: "linear-gradient(135deg, #7C3AED 0%, #4C1D95 100%)",
  },
  {
    icon: ShieldCheck,
    titleFr: "Systèmes sécurisés",
    titleEn: "Secure Systems",
    descFr: "Architecture sécurisée dès la conception, protection des données et conformité.",
    descEn: "Security by design architecture, data protection and compliance.",
    gradient: "linear-gradient(135deg, #0EA5E9 0%, #1E40AF 100%)",
  },
];
---

<section id="services" class="services-section section-padding">
  <div class="container">
    <div class="services-grid">
      {services.map((service) => {
        const Icon = service.icon;
        const title = lang === 'fr' ? service.titleFr : service.titleEn;
        const desc = lang === 'fr' ? service.descFr : service.descEn;
        return (
          <div class="service-card glass-panel reveal">
            <div class="service-icon-wrapper" style={`background: ${service.gradient}`}>
              <Icon size={28} color="white" />
            </div>
            <h3 class="service-title">{title}</h3>
            <p class="service-desc">{desc}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
.services-section {
  background: var(--bg-primary);
  padding-bottom: 0;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.service-card {
  padding: 2.5rem 2rem;
  border-radius: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: default;
}

.service-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 40px var(--accent-glow);
  border-color: var(--accent-primary);
}

.service-icon-wrapper {
  width: 60px;
  height: 60px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8px 20px var(--accent-glow);
}

.service-title {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0;
}

.service-desc {
  font-size: 0.95rem;
  color: var(--text-secondary);
  line-height: 1.7;
  margin: 0;
}

@media (max-width: 768px) {
  .services-grid {
    grid-template-columns: 1fr;
  }
}
</style>
