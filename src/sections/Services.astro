---
import { CreditCard, Zap, ShieldCheck } from 'lucide-react';
import { getTranslations } from '../utils/t';

const { lang = 'fr' } = Astro.props;
const t = getTranslations(lang);
const conversion = lang === "en" ? {
  title: "What you get",
  subtitle: "A clear process, a direct exchange, and a deliverable that moves the project forward.",
  cta: "Start a project",
  note: "Let's chat",
  cards: [
    { index: "01", title: "Fast diagnosis", description: "I identify the real business problem, the technical constraints and the shortest route to a useful deliverable." },
    { index: "02", title: "Outcome-driven delivery", description: "I build interfaces, APIs and integrations with one objective: something usable that moves the project forward." },
    { index: "03", title: "Security and reliability", description: "Clean architecture, protected data and stable deployment so the project feels safe to buy." },
    { index: "04", title: "Simple next step", description: "No funnel, no long questionnaire. One message is enough to start the discussion." }
  ]
} : {
  title: "Ce que vous recevez",
  subtitle: "Un cadre clair, une réponse directe et une suite concrète.",
  cta: "Démarrer le projet",
  note: "Discutons",
  cards: [
    { index: "01", title: "Diagnostic rapide", description: "Je repère le vrai problème métier, les contraintes techniques et la route la plus courte vers un livrable utile." },
    { index: "02", title: "Livraison orientée résultat", description: "Je construis interfaces, API et intégrations avec un seul objectif : quelque chose d'utilisable qui fait avancer le projet." },
    { index: "03", title: "Sécurité et fiabilité", description: "Architecture propre, données protégées et déploiement stable pour inspirer confiance avant la signature." },
    { index: "04", title: "Prochaine étape simple", description: "Pas de tunnel, pas de questionnaire interminable. Un message suffit pour lancer la discussion." }
  ]
};

const services = [
  {
    id: 'fintech',
    icon: CreditCard,
    title: t('services.fintech.title'),
    desc: t('services.fintech.description'),
    gradient: "linear-gradient(135deg, #2962FF 0%, #7C3AED 100%)",
    size: 'large'
  },
  {
    id: 'automation',
    icon: Zap,
    title: t('services.automation.title'),
    desc: t('services.automation.description'),
    gradient: "linear-gradient(135deg, #7C3AED 0%, #4C1D95 100%)",
    size: 'small'
  },
  {
    id: 'security',
    icon: ShieldCheck,
    title: t('services.security.title'),
    desc: t('services.security.description'),
    gradient: "linear-gradient(135deg, #0EA5E9 0%, #1E40AF 100%)",
    size: 'small'
  },
];
---

<section id="services" class="services-section section-padding">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{t('services.title')}</h2>
      <p class="section-subtitle">{t('services.subtitle')}</p>
    </div>

<div class="conversion-panel">
      <div class="conversion-header-copy">
        <h3 class="conversion-title">{conversion.title}</h3>
        <p class="conversion-subtitle">{conversion.subtitle}</p>
      </div>

      <div class="conversion-cards">
        {conversion.cards.map((card) => (
          <article class="conversion-card">
            <span class="conversion-index">{card.index}</span>
            <h4 class="conversion-card-title">{card.title}</h4>
            <p class="conversion-card-desc">{card.description}</p>
          </article>
        ))}
      </div>

      <div class="conversion-cta-row">
        <a href="#contact" class="btn btn-primary">{conversion.cta}</a>
        <span class="conversion-note">{conversion.note}</span>
      </div>
    </div>
    <div class="services-bento">
      {services.map((service) => {
        const Icon = service.icon;
        return (
          <div class={`service-card glass-panel ${service.size}`}>
            <div class="service-content">
              <div class="service-icon-wrapper" style={`background: ${service.gradient}`}>
                <Icon size={32} color="white" />
              </div>
              <div class="service-text">
                <h3 class="service-title">{service.title}</h3>
                <p class="service-desc">{service.desc}</p>
              </div>
            </div>
            <div class="service-glow" style={`background: ${service.gradient}`}></div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
.services-section {
  background: var(--bg-primary);
  position: relative;
  overflow: hidden;
}

.services-bento {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(2, minmax(160px, auto));
  gap: 1.5rem;
  margin-top: 3rem;
}

.service-card {
  position: relative;
  border-radius: 2rem;
  padding: 2.5rem;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
  transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid var(--border-color);
  background: var(--bg-secondary);
}

.service-card.large {
  grid-column: span 2;
  grid-row: span 2;
  justify-content: space-between;
}

.service-card.small {
  grid-column: span 2;
  grid-row: span 1;
  flex-direction: row;
  align-items: center;
}

.service-card:hover {
  transform: translateY(-8px);
  border-color: var(--accent-primary);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
}

.service-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.small .service-content {
  flex-direction: row;
  align-items: center;
  gap: 2rem;
}

.service-icon-wrapper {
  width: 70px;
  height: 70px;
  min-width: 70px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10px 25px var(--accent-glow);
}

.service-title {
  font-size: 1.75rem;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 0.75rem;
  letter-spacing: -0.02em;
}

.small .service-title {
  font-size: 1.4rem;
  margin-bottom: 0.5rem;
}

.service-desc {
  font-size: 1.05rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

.service-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 150%;
  height: 150%;
  filter: blur(80px);
  opacity: 0;
  transition: opacity 0.6s ease;
  z-index: 1;
  pointer-events: none;
}

.service-card:hover .service-glow {
  opacity: 0.1;
}

.conversion-panel {
  margin-top: 2.5rem;
  padding: 2.5rem;
  border-radius: 1.5rem;
  border: 1px solid var(--border-color);
  background: var(--bg-secondary);
}

.conversion-header-copy {
  max-width: 760px;
  margin-bottom: 1.5rem;
}



.conversion-title {
  font-size: clamp(1.8rem, 3vw, 2.6rem);
  margin-bottom: 0.6rem;
  letter-spacing: -0.03em;
}

.conversion-subtitle {
  color: var(--text-secondary);
  line-height: 1.7;
  max-width: 850px;
}

.conversion-cards {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
  margin: 1.5rem 0;
}

.conversion-card {
  padding: 1.25rem 1.25rem 1.35rem;
  border-radius: 1.25rem;
  border: 1px solid var(--border-color);
  background: rgba(3, 4, 11, 0.25);
}

.conversion-index {
  display: inline-flex;
  margin-bottom: 0.85rem;
  color: var(--accent-cyan);
  font-size: 0.85rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.conversion-card-title {
  margin-bottom: 0.5rem;
  font-size: 1.1rem;
}

.conversion-card-desc {
  color: var(--text-secondary);
  line-height: 1.6;
}

.conversion-cta-row {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.conversion-note {
  color: var(--text-secondary);
  font-size: 0.95rem;
}

@media (max-width: 720px) {
  .conversion-panel {
    padding: 1.5rem;
  }

  .conversion-cards {
    grid-template-columns: 1fr;
  }

  .conversion-cta-row {
    align-items: flex-start;
  }
}


@media (max-width: 1024px) {
  .services-bento {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
  }
  .service-card.large, .service-card.small {
    grid-column: span 1;
    grid-row: span 1;
    flex-direction: column;
    align-items: flex-start;
  }
  .small .service-content {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>
