---
import { ArrowRight, Download, Github, Linkedin, Mail, Facebook, Gitlab } from 'lucide-react';
import '../styles/Hero.css';
import { getTranslations } from '../utils/t';
import { Image } from 'astro:assets';
import profileImg from '../assets/images/me.jpeg';

const { lang = 'fr' } = Astro.props;
const t = getTranslations(lang);
const cvFile = lang === 'en' ? '/Bhilal CV en.pdf' : '/Bhilal CV fr.pdf';
const cvName = lang === 'en' ? 'Bhilal_CHITOU_CV_EN.pdf' : 'Bhilal_CHITOU_CV_FR.pdf';
---

<section id="home" class="hero-section">
  <div class="hero-background">
    <div class="glow-orb orb-1"></div>
    <div class="glow-orb orb-2"></div>
  </div>
  
  <div class="container hero-container">
    <div class="hero-content">
      <h1 class="hero-title reveal reveal-stagger-2">
        {t('hero.welcome')} <span class="text-accent">Bhilal CHITOU</span>
        <br />
        {t('hero.role')}
      </h1>
      
      <p class="hero-description reveal reveal-stagger-3">
        {t('hero.description')}
      </p>
      
      <div class="hero-actions reveal reveal-stagger-4">
        <a href="#projects" class="btn btn-primary">
          {t('hero.viewWork')}
          <ArrowRight size={18} />
        </a>
        <a href={cvFile} class="btn btn-outline" download={cvName}>
          {t('hero.downloadCV')}
          <Download size={18} />
        </a>
      </div>
    </div>
    
    <div class="hero-visual reveal" style={{ animationDelay: '0.2s' }}>
      <div class="profile-image-wrapper">
         <div class="saturn-rings">
           <div class="orbiting-icons">
             <a href="https://github.com/7Bhil/" target="_blank" rel="noopener noreferrer" class="orbit-icon icon-1">
               <Github size={22} />
             </a>
             <a href="https://gitlab.com/7Bhil" target="_blank" rel="noopener noreferrer" class="orbit-icon icon-2">
               <Gitlab size={22} />
             </a>
             <a href="https://www.linkedin.com/in/bhilal-chitou/" target="_blank" rel="noopener noreferrer" class="orbit-icon icon-3">
               <Linkedin size={22} />
             </a>
             <a href="https://web.facebook.com/7Bhil" target="_blank" rel="noopener noreferrer" class="orbit-icon icon-4">
               <Facebook size={22} />
             </a>
             <a href="mailto:7bhilal.chitou7@gmail.com" class="orbit-icon icon-5">
               <Mail size={22} />
             </a>
           </div>
         </div>
         
         <Image src={profileImg} alt="Bhilal CHITOU" class="profile-img" width={400} height={400} loading="eager" />
         <div class="profile-glow"></div>
      </div>
    </div>
  </div>
</section>
