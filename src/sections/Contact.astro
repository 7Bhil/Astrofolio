---
import { MapPin, Phone, Mail } from 'lucide-react';
import { getTranslations } from '../utils/t';
import { translations } from '../constants/translations';
import ContactForm from '../components/ContactForm';
import '../styles/Contact.css';

const { lang = 'fr' } = Astro.props;
const t = getTranslations(lang);
---

<section id="contact" class="section-padding contact-section">
  <div class="container">
    <div class="section-header text-center mb-12 reveal">
      <h2 class="section-title">{t('contact.title')}</h2>
      <p class="section-subtitle">
        {t('contact.subtitle')}
      </p>
    </div>

    <div class="contact-grid glass-panel reveal reveal-stagger-1">
      <div class="contact-info">
        <h3 class="contact-info-title">{t('contact.infoTitle')}</h3>
        <p class="contact-info-desc">
          {t('contact.infoDesc')}
        </p>
        
        <div class="info-items">
          <div class="info-item">
            <div class="info-icon">
              <Phone size={20} />
            </div>
            <span>+229 01 98 87 40 19</span>
          </div>
          <div class="info-item">
            <div class="info-icon">
              <Mail size={20} />
            </div>
            <span>7bhilal.chitou7@gmail.com</span>
          </div>
          <div class="info-item">
            <div class="info-icon">
              <MapPin size={20} />
            </div>
            <span>Remote / Full-time</span>
          </div>
        </div>
        
        <div class="contact-shape"></div>
      </div>
      
      <ContactForm client:load translations={translations[lang].contact} />
    </div>
  </div>
</section>
