---
import { MapPin, Mail, MessageCircle, Phone } from 'lucide-react';
import { getTranslations } from '../utils/t';
import '../styles/Contact.css';

const { lang = 'fr' } = Astro.props;
const t = getTranslations(lang);
const whatsappNumber = '2290144242964';
const whatsappText = lang === 'en'
  ? 'Hello Bhilal, I would like to discuss a project with you.'
  : 'Bonjour Bhilal, je souhaite discuter d\'un projet avec vous.';
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappText)}`;
---

<section id="contact" class="section-padding contact-section">
  <div class="container">
    <div class="section-header text-center mb-12 reveal">
      <h2 class="section-title">{t('contact.title')}</h2>
      <p class="section-subtitle">
        {t('contact.subtitle')}
      </p>
    </div>

    <div class="contact-grid glass-panel reveal reveal-stagger-1">
      <div class="contact-info">
        <h3 class="contact-info-title">{t('contact.infoTitle')}</h3>
        <p class="contact-info-desc">
          {t('contact.infoDesc')}
        </p>
        
        <div class="info-items">
          <div class="info-item">
            <div class="info-icon">
              <Phone size={20} />
            </div>
            <span>+229 01 44 24 29 64</span>
          </div>
          <div class="info-item">
            <div class="info-icon">
              <Mail size={20} />
            </div>
            <span>7bhilal.chitou7@gmail.com</span>
          </div>
          <div class="info-item">
            <div class="info-icon">
              <MapPin size={20} />
            </div>
            <span>Remote / Full-time</span>
          </div>
        </div>
        
        <div class="contact-shape"></div>
      </div>

      <div class="whatsapp-contact">
        <div class="whatsapp-card">
          <div class="whatsapp-icon" aria-hidden="true">
            <MessageCircle size={34} />
          </div>
          <div class="whatsapp-copy">
            <h3>{t('contact.whatsappTitle')}</h3>
            <p>{t('contact.whatsappDesc')}</p>
          </div>
          <a
            class="btn whatsapp-btn"
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('contact.whatsappAria')}
          >
            <MessageCircle size={20} />
            <span>{t('contact.whatsappCta')}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
