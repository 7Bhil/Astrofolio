---
import { ExpandableProjects } from '../components/ExpandableProjects';
import ProjectCard from '../components/ProjectCard.astro';
import { getTranslations } from '../utils/t';
import '../styles/Projects.css';

import bhilalImg from '../assets/images/language.webp';
import bhilCoursImg from '../assets/images/cours.webp';
import arrondissementImg from '../assets/images/arrondissement.webp';
import challengeImg from '../assets/images/challenge.webp';
import restoImg from '../assets/images/resto.webp';
import vitchImg from '../assets/images/vitch.webp';

const { lang = 'fr' } = Astro.props;
const t = getTranslations(lang);

const featuredProjects = [
  {
    title: t('projects.bhilal.title'),
    description: t('projects.bhilal.description'),
    tags: ["Node.js", "Go", "Cybersecurity", "Custom Language"],
    image: bhilalImg,
    githubUrl: "https://github.com/7Bhil/Language-Bhilal",
    liveUrl: "https://bhil-documentations.netlify.app/"
  },
  {
    title: t('projects.bhilcours.title'),
    description: t('projects.bhilcours.description'),
    tags: ["React", "Django", "PostgreSQL"],
    image: bhilCoursImg,
    githubUrl: "https://github.com/7Bhil/Cours-front",
    liveUrl: "https://bhilcours.netlify.app/"
  },
  {
    title: t('projects.arrondissement.title'),
    description: t('projects.arrondissement.description'),
    tags: ["React", "UI/UX", "Political Party"],
    image: arrondissementImg,
    githubUrl: "https://github.com/7Bhil/Arrondissement",
    liveUrl: "https://chef-d-arrondissement.netlify.app/"
  },
  {
    title: t('projects.challenge.title'),
    description: t('projects.challenge.description'),
    tags: ["MERN Stack", "State Management", "Leaderboard"],
    image: challengeImg,
    githubUrl: "https://github.com/7Bhil/Challenge-react",
    liveUrl: "https://challenge-react-delta.vercel.app/"
  },
  {
    title: t('projects.resto.title'),
    description: t('projects.resto.description'),
    tags: ["React", "Tailwind CSS", "Premium UI"],
    image: restoImg,
    githubUrl: "https://github.com/7Bhil/Restaurant",
    liveUrl: "https://restaurant-nine-tau.vercel.app/"
  },
  {
    title: t('projects.vitch.title'),
    description: t('projects.vitch.description'),
    tags: ["React", "Fintech", "Online Payment"],
    image: vitchImg,
    githubUrl: "https://github.com/7Bhil/wallet-next",
    liveUrl: "https://vitch.vercel.app/"
  }
];
---

<section id="projects" class="section-padding projects-section">
  <div class="container mx-auto px-4">
    <div class="section-header reveal mb-16">
      <h2 class="section-title text-4xl font-bold mb-4">{t('projects.title')}</h2>
      <p class="section-subtitle text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl">{t('projects.subtitle')}</p>
    </div>
    
    <ExpandableProjects
      projects={featuredProjects}
      labels={{ demo: t('projects.demo'), viewDetails: t('projects.viewDetails') }}
      client:load
    />
  </div>
</section>
