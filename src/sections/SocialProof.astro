---
const { lang = 'fr' } = Astro.props;

const content = lang === 'en' ? {
  sectionTitle: 'Track record',
  sectionSubtitle: 'What I\'ve shipped, how I work, and what the stack looks like.',
  stats: [
    { value: '12+', label: 'Projects shipped' },
    { value: '6', label: 'Industries' },
    { value: '<48h', label: 'First reply' },
    { value: '0', label: 'Missed deadlines' }
  ],
  deliveries: [
    {
      category: 'Fintech',
      items: [
        'Secure electronic wallet with virtual card issuance',
        'Mobile money payment gateway integration (MTN / Moov)'
      ]
    },
    {
      category: 'Platforms',
      items: [
        'Interactive learning platform (React + Django)',
        'Real-time coding challenge platform with jury grading',
        'Institutional web application for a national organization'
      ]
    },
    {
      category: 'Tools & Systems',
      items: [
        'Bilingual programming language transpiling to JavaScript',
        'Admin dashboards with role-based access and analytics',
        'Restaurant and event management interfaces'
      ]
    }
  ],
  processTitle: 'How a project runs',
  steps: [
    { num: '01', title: 'Scope call', desc: 'You describe the problem. I confirm if I can solve it, how long it takes, and what it costs. 15 minutes, no fluff.' },
    { num: '02', title: 'Build phase', desc: 'I work in short iterations with check-ins. You see progress every few days, not after 6 weeks of silence.' },
    { num: '03', title: 'Delivery & handoff', desc: 'Clean code, documentation, deployment. You own everything. I stay available for questions after launch.' }
  ]
} : {
  sectionTitle: 'Bilan',
  sectionSubtitle: 'Ce que j\'ai livré, comment je travaille, et la stack que je maîtrise.',
  stats: [
    { value: '12+', label: 'Projets livrés' },
    { value: '6', label: 'Secteurs' },
    { value: '<48h', label: 'Première réponse' },
    { value: '0', label: 'Deadline ratée' }
  ],
  deliveries: [
    {
      category: 'Fintech',
      items: [
        'Portefeuille électronique sécurisé avec émission de cartes virtuelles',
        'Intégration de passerelles de paiement mobile money (MTN / Moov)'
      ]
    },
    {
      category: 'Plateformes',
      items: [
        'Plateforme d\'apprentissage interactive (React + Django)',
        'Plateforme de challenges avec notation en temps réel',
        'Application web institutionnelle pour une organisation nationale'
      ]
    },
    {
      category: 'Outils & Systèmes',
      items: [
        'Langage de programmation bilingue transpilant vers JavaScript',
        'Dashboards admin avec gestion de rôles et analytics',
        'Interfaces de gestion événementielle et restauration'
      ]
    }
  ],
  processTitle: 'Comment se déroule un projet',
  steps: [
    { num: '01', title: 'Appel de cadrage', desc: 'Vous décrivez le problème. Je confirme si je peux le résoudre, combien de temps ça prend, et combien ça coûte. 15 minutes, pas de blabla.' },
    { num: '02', title: 'Phase de construction', desc: 'Je travaille en itérations courtes avec des points réguliers. Vous voyez l\'avancement tous les quelques jours, pas après 6 semaines de silence.' },
    { num: '03', title: 'Livraison & remise', desc: 'Code propre, documentation, déploiement. Vous êtes propriétaire de tout. Je reste disponible pour les questions après le lancement.' }
  ]
};
---

<section id="track-record" class="tr-section section-padding">
  <div class="container">

    <div class="tr-header reveal">
      <h2 class="section-title">{content.sectionTitle}</h2>
      <p class="section-subtitle">{content.sectionSubtitle}</p>
    </div>

    <!-- Stats — just the numbers, no decoration -->
    <div class="tr-stats reveal reveal-stagger-1">
      {content.stats.map((stat) => (
        <div class="tr-stat">
          <span class="tr-stat-value">{stat.value}</span>
          <span class="tr-stat-label">{stat.label}</span>
        </div>
      ))}
    </div>

    <!-- What I've actually built -->
    <div class="tr-deliveries reveal reveal-stagger-2">
      {content.deliveries.map((group) => (
        <div class="tr-delivery-group">
          <h4 class="tr-delivery-category">{group.category}</h4>
          <ul class="tr-delivery-list">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Process -->
    <div class="tr-process reveal reveal-stagger-3">
      <h3 class="tr-process-title">{content.processTitle}</h3>
      <div class="tr-steps">
        {content.steps.map((step) => (
          <div class="tr-step">
            <span class="tr-step-num">{step.num}</span>
            <div class="tr-step-content">
              <h4>{step.title}</h4>
              <p>{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
.tr-section {
  position: relative;
  background: var(--bg-primary);
}

.tr-header {
  margin-bottom: 3rem;
}

/* Stats */
.tr-stats {
  display: flex;
  gap: 3rem;
  margin-bottom: 3.5rem;
  padding-bottom: 2.5rem;
  border-bottom: 1px solid var(--border-color);
}

.tr-stat {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.tr-stat-value {
  font-family: 'Outfit', sans-serif;
  font-size: 2.4rem;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1;
  letter-spacing: -1px;
}

.tr-stat-label {
  font-size: 0.88rem;
  color: var(--text-muted);
  font-weight: 500;
}

/* Deliveries */
.tr-deliveries {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  margin-bottom: 3.5rem;
}

.tr-delivery-category {
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--accent-primary);
  font-weight: 700;
  margin-bottom: 1rem;
}

.tr-delivery-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.tr-delivery-list li {
  position: relative;
  padding-left: 1rem;
  font-size: 0.92rem;
  color: var(--text-secondary);
  line-height: 1.55;
}

.tr-delivery-list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.55rem;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--text-muted);
}

/* Process */
.tr-process {
  padding-top: 2.5rem;
  border-top: 1px solid var(--border-color);
}

.tr-process-title {
  font-size: 1.4rem;
  font-weight: 800;
  margin-bottom: 2rem;
  letter-spacing: -0.02em;
}

.tr-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.tr-step {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
}

.tr-step-num {
  font-family: 'Outfit', sans-serif;
  font-size: 1.3rem;
  font-weight: 900;
  color: var(--accent-primary);
  opacity: 0.35;
  line-height: 1.3;
  min-width: 2rem;
}

.tr-step-content h4 {
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 0.35rem;
  color: var(--text-primary);
}

.tr-step-content p {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* Responsive */
@media (max-width: 1024px) {
  .tr-deliveries {
    grid-template-columns: 1fr;
  }
  .tr-steps {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .tr-stats {
    flex-wrap: wrap;
    gap: 1.5rem 2.5rem;
  }
}
</style>
