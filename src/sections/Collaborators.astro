---
import { ArrowUpRight, Users } from 'lucide-react';
import { collaborators } from '../data/collaborators.js';

interface Props {
  lang?: string;
}

const { lang = 'fr' } = Astro.props;

const texts = lang === 'en' ? {
  badge: "Ecosystem & Network",
  title: "Collaborators & Network",
  subtitle: "Talented engineers, architects, and developers I actively work with or recommend.",
  visit: "View portfolio"
} : {
  badge: "Écosystème & Partenaires",
  title: "Réseau & Collaborateurs",
  subtitle: "Ingénieurs, développeurs et créatifs talentueux avec qui je collabore régulièrement ou que je recommande.",
  visit: "Voir le portfolio"
};
---

<section id="collaborators" class="py-24 relative overflow-hidden">
  {/* Ambient background glow */}
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-cyan-500/5 blur-[120px] rounded-full"></div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    {/* Section Header */}
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-mono tracking-wider uppercase mb-4">
        <Users size={14} />
        <span>{texts.badge}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4">
        {texts.title}
      </h2>
      <p class="text-neutral-400 text-sm sm:text-base leading-relaxed">
        {texts.subtitle}
      </p>
    </div>

    {/* Collaborators Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-5">
      {collaborators.map((c) => (
        <a
          href={c.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative rounded-2xl p-4 sm:p-5 bg-neutral-900/40 hover:bg-neutral-900/80 border border-neutral-800/80 hover:border-cyan-500/40 transition-all duration-300 flex flex-col justify-between hover:-translate-y-1 hover:shadow-xl hover:shadow-cyan-950/20"
        >
          {/* Top card row: Avatar + External arrow */}
          <div class="flex items-start justify-between gap-3 mb-4">
            <div class="relative w-14 h-14 rounded-xl overflow-hidden bg-neutral-800 border border-neutral-700/60 flex items-center justify-center shrink-0">
              {c.avatar ? (
                <img
                  src={c.avatar}
                  alt={c.name}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              ) : (
                <span class="font-mono font-bold text-sm text-cyan-300">
                  {c.initials}
                </span>
              )}
            </div>

            <div class="p-2 rounded-lg bg-neutral-800/50 text-neutral-400 group-hover:text-cyan-400 group-hover:bg-cyan-500/10 transition-colors">
              <ArrowUpRight size={16} />
            </div>
          </div>

          {/* Info */}
          <div>
            <h3 class="text-base font-bold text-neutral-100 group-hover:text-cyan-300 transition-colors tracking-tight line-clamp-1">
              {c.name}
            </h3>
            <p class="text-xs text-neutral-400 mt-1 line-clamp-1 font-mono">
              {c.role}
            </p>
          </div>

          {/* Footer micro-link */}
          <div class="mt-4 pt-3 border-t border-neutral-800/60 flex items-center justify-between text-[11px] text-neutral-500 group-hover:text-cyan-400/80 font-mono transition-colors">
            <span>{texts.visit}</span>
            <span class="text-neutral-600 group-hover:text-cyan-500 transition-colors">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
