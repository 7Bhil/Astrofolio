---
import { Code2, Server, Smartphone, ShieldCheck, Terminal, Cpu } from 'lucide-react';
import { getTranslations } from '../utils/t';
import '../styles/Skills.css';

const { lang = 'fr' } = Astro.props;
const t = getTranslations(lang);

const skillCategories = [
  {
    id: 'frontend',
    title: t('skills.frontend'),
    icon: Code2,
    skills: [
      { name: 'TypeScript', icon: 'typescript' },
      { name: 'JavaScript (ES6+)', icon: 'javascript' },
      { name: 'React', icon: 'react' },
      { name: 'Next.js', icon: 'nextdotjs' },
      { name: 'Astro', icon: 'astro' },
      { name: 'Tailwind CSS', icon: 'tailwindcss' },
      { name: 'HTML5 / CSS3', icon: 'html5' }
    ]
  },
  {
    id: 'backend',
    title: t('skills.backend'),
    icon: Server,
    skills: [
      { name: 'NestJS', icon: 'nestjs' },
      { name: 'Node.js', icon: 'nodedotjs' },
      { name: 'Express', icon: 'express' },
      { name: 'Python', icon: 'python' },
      { name: 'Django', icon: 'django' },
      { name: 'PHP / Laravel', icon: 'laravel' },
      { name: 'PostgreSQL', icon: 'postgresql' },
      { name: 'MongoDB', icon: 'mongodb' }
    ]
  },
  {
    id: 'mobile',
    title: t('skills.mobile'),
    icon: Smartphone,
    skills: [
      { name: 'React Native', icon: 'react' },
      { name: 'Expo', icon: 'expo' },
      { name: 'Mobile Architecture', icon: 'android' },
      { name: 'PWA (Progressive Web Apps)', icon: 'pwa' }
    ]
  },
  {
    id: 'devops_security',
    title: t('skills.tools_security'),
    icon: ShieldCheck,
    skills: [
      { name: 'Docker', icon: 'docker' },
      { name: 'Linux / Bash', icon: 'linux' },
      { name: 'Git & GitHub', icon: 'git' },
      { name: 'OWASP & Sécurité Web', icon: 'kalilinux' },
      { name: 'Vercel / Cloud', icon: 'vercel' },
      { name: 'CI/CD Pipelines', icon: 'githubactions' }
    ]
  }
];

const getIconUrl = (slug) => `https://cdn.simpleicons.org/${slug}`;
---

<section id="skills" class="section-padding skills-section">
  <div class="container">
    <div class="section-header reveal">
      <h2 class="section-title">{t('skills.title')}</h2>
      <p class="section-subtitle">{t('skills.subtitle')}</p>
    </div>

    <div class="skills-grid">
      {skillCategories.map((category, index) => (
        <div 
          class="skill-card glass-panel reveal" 
          style={{ transitionDelay: `${index * 0.1}s` }}
        >
          <div class="bento-content">
            <div class="bento-header">
              <div class="icon-wrapper">
                <category.icon class="skill-icon" />
              </div>
              <h3>{category.title}</h3>
            </div>
            
            <div class="skill-tags">
              {category.skills.map((skill) => (
                <span class="skill-tag">
                  <img 
                    src={getIconUrl(skill.icon)} 
                    alt={skill.name} 
                    class="tech-logo"
                    loading="lazy"
                  />
                  {skill.name}
                </span>
              ))}
            </div>
          </div>
          <div class="bento-bg-glow"></div>
        </div>
      ))}
    </div>
  </div>
</section>
