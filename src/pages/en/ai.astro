---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.jsx';
import Chatbot from '../../components/Chatbot.jsx';
import { translations } from '../../constants/translations';
import { Bot, ArrowLeft } from 'lucide-react';

const lang = 'en';
const footerText = translations[lang].footer.rights;
---

<Layout 
  title="AI Console & Recruiter Assistant — Bhilal CHITOU (7Bhil)" 
  description="Chat live with Bhilal CHITOU's AI assistant to explore his fintech systems, compiler architecture, tech stack, and contract availability."
  lang={lang}
>
  <Navbar client:load lang={lang} translations={translations[lang]} />
  
  <main class="ai-page-fullscreen">
    <Chatbot client:load lang={lang} standalone={true} />
  </main>
</Layout>

<style>
.ai-page-fullscreen {
  height: 100vh;
  height: 100dvh;
  padding-top: 4.5rem;
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
</style>
