---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.jsx';
import Chatbot from '../../components/Chatbot.jsx';
import { translations } from '../../constants/translations';
import { Bot, ArrowLeft } from 'lucide-react';

const lang = 'en';
const footerText = translations[lang].footer.rights;
---

<Layout title="AI Assistant & Scoping Console — Bhilal CHITOU (7Bhil)" lang={lang}>
  <Navbar client:load lang={lang} translations={translations[lang]} />
  
  <main class="ai-page-main">
    <div class="container ai-page-container">
      
      <!-- Page Header -->
      <div class="ai-page-header">
        <a href="/en/" class="ai-back-link">
          <ArrowLeft size={16} />
          <span>Back to homepage</span>
        </a>

        <div class="ai-title-block">
          <div class="ai-page-badge">
            <Bot size={16} />
            <span>Interactive Technical Agent</span>
          </div>
          <h1 class="ai-page-title">AI Console & Project Scoping</h1>
          <p class="ai-page-description">
            Interact directly with my virtual agent to explore system architecture, qualify project requirements, and submit a structured brief within 24 hours.
          </p>
        </div>
      </div>

      <!-- Full-Page Interactive Console -->
      <div class="ai-console-wrapper">
        <Chatbot client:load lang={lang} standalone={true} />
      </div>

    </div>
  </main>

  <footer style={{ textAlign: 'center', padding: '2rem', borderTop: '1px solid var(--border-color)', color: 'var(--text-secondary)' }}>
    <div class="container">
      <p>&copy; {new Date().getFullYear()} Bhilal CHITOU. {footerText}</p>
    </div>
  </footer>
</Layout>

<style>
.ai-page-main {
  min-height: 100vh;
  padding-top: 6.5rem;
  padding-bottom: 3.5rem;
  background: radial-gradient(circle at 50% 15%, rgba(6, 182, 212, 0.08) 0%, transparent 60%), var(--bg-primary);
}

.ai-page-container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 1.25rem;
}

.ai-page-header {
  margin-bottom: 2rem;
}

.ai-back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--text-secondary);
  font-size: 0.85rem;
  font-weight: 500;
  text-decoration: none;
  margin-bottom: 1.5rem;
  transition: all 0.2s ease;
}

.ai-back-link:hover {
  color: var(--accent-cyan);
  transform: translateX(-3px);
}

.ai-title-block {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.ai-page-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  width: fit-content;
  background: rgba(6, 182, 212, 0.1);
  border: 1px solid rgba(6, 182, 212, 0.25);
  padding: 0.35rem 0.85rem;
  border-radius: 9999px;
  color: var(--accent-cyan);
  font-size: 0.8rem;
  font-weight: 600;
}

.ai-page-title {
  font-size: 2.25rem;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.02em;
  margin: 0;
}

.ai-page-description {
  color: var(--text-secondary);
  font-size: 1.05rem;
  line-height: 1.6;
  max-width: 720px;
  margin: 0;
}

.ai-console-wrapper {
  margin-top: 1.5rem;
  border-radius: 1.5rem;
  overflow: hidden;
}

@media (max-width: 768px) {
  .ai-page-main {
    padding-top: 5rem;
  }
  .ai-page-title {
    font-size: 1.75rem;
  }
  .ai-page-description {
    font-size: 0.95rem;
  }
}
</style>
