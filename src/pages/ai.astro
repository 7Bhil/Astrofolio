---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Chatbot from '../components/Chatbot.jsx';
import { translations } from '../constants/translations';
import { Bot, Terminal, Shield, ArrowLeft } from 'lucide-react';

const lang = 'fr';
const footerText = translations[lang].footer.rights;
---

<Layout title="Assistant Technique & Projet — Bhilal CHITOU (7Bhil)" lang={lang}>
  <Navbar client:load lang={lang} translations={translations[lang]} />
  
  <main class="ai-page-fullscreen">
    <Chatbot client:load lang={lang} standalone={true} />
  </main>
</Layout>

<style>
.ai-page-fullscreen {
  height: 100vh;
  height: 100dvh;
  padding-top: 4.5rem; /* Espace pour la Navbar */
  background: var(--bg-primary);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
</style>
